<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CIE NFC POC v0.2" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Offline. DG2/3/4 mai letti. Solo BAC richiede un nuovo avvicinamento fisico della carta." android:paddingTop="8dp" android:paddingBottom="12dp"/>
<RadioGroup android:id="@+id/mode" android:layout_width="match_parent" android:layout_height="wrap_content">
<RadioButton android:id="@+id/modeCan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAN — PACE" android:checked="true"/>
<RadioButton android:id="@+id/modeMrz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MRZ — PACE con fallback BAC"/>
<RadioButton android:id="@+id/modeBac" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MRZ — SOLO BAC (lettura separata)"/>
</RadioGroup>
<EditText android:id="@+id/can" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="CAN" android:inputType="numberPassword" android:maxLength="6"/>
<EditText android:id="@+id/docNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Numero documento" android:visibility="gone"/>
<EditText android:id="@+id/birth" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Data nascita YYMMDD" android:inputType="numberPassword" android:visibility="gone"/>
<EditText android:id="@+id/expiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Scadenza YYMMDD" android:inputType="numberPassword" android:visibility="gone"/>
<Button android:id="@+id/arm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Avvia lettura NFC"/>
<Button android:id="@+id/copyReport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copia report senza PII"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="In attesa." android:paddingTop="12dp" android:textIsSelectable="true"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DATI LETTI — SOLO SCHERMO" android:textStyle="bold" android:paddingTop="18dp"/>
<TextView android:id="@+id/screenData" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nessun dato." android:textIsSelectable="false"/>
</LinearLayout></ScrollView>